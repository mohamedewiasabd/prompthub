rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Categories: anyone can read, authenticated admin or server can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Prompts: anyone can read, anyone can increment stats (views/copies/likes), admin/server can write
    match /prompts/{promptId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews: anyone can read and submit review
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Settings & Sync Store
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // App state synchronization
    match /system/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
