# Maintainer: PromptHub <mohamedewiasabd@gmail.com>
# Contributor: PromptHub <mohamedewiasabd@gmail.com>
pkgname=prompthub
pkgver=1.0.0
pkgrel=1
pkgdesc="مكتبة البرومبتات الذكية — منصة عربية لبرومبتات الذكاء الاصطناعي مع توليد ذكي عبر Gemini (Arabic AI prompts library with Gemini)"
arch=('x86_64')
url="https://github.com/mohamedewiasabd/prompthub"
license=('custom:AllRightsReserved')
depends=('webkit2gtk-4.1' 'gtk3' 'librsvg2' 'libayatana-appindicator' 'openssl')
makedepends=('rust' 'cargo' 'glib2' 'gdk-pixbuf2')
provides=('prompthub')
conflicts=('prompthub-bin')
options=('strip')
source=("prompthub::git+https://github.com/mohamedewiasabd/prompthub.git#tag=v${pkgver}")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/prompthub"
  git describe --tags --abbrev=0 | tr -d 'v' || echo "${pkgver}"
}

build() {
  cd "${srcdir}/prompthub"
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo build --release --manifest-path src-tauri/Cargo.toml
}

check() {
  cd "${srcdir}/prompthub"
  test -x "${srcdir}/target/release/prompthub"
}

package() {
  cd "${srcdir}/prompthub"
  install -Dm755 "${srcdir}/target/release/prompthub" "${pkgdir}/usr/bin/prompthub"
  install -Dm644 packaging/linux/io.github.mohamedewiasabd.prompthub.desktop \
    "${pkgdir}/usr/share/applications/io.github.mohamedewiasabd.prompthub.desktop"
  install -Dm644 packaging/linux/io.github.mohamedewiasabd.prompthub.metainfo.xml \
    "${pkgdir}/usr/share/metainfo/io.github.mohamedewiasabd.prompthub.metainfo.xml"
  install -Dm644 src-tauri/icons/32x32.png \
    "${pkgdir}/usr/share/icons/hicolor/32x32/apps/io.github.mohamedewiasabd.prompthub.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/io.github.mohamedewiasabd.prompthub.png"
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/io.github.mohamedewiasabd.prompthub.png"
}